# U-Boot environment for fw_printenv / fw_setenv (libubootenv) and RAUC.
# Linux maps both QEMU "virt" flash banks as one MTD device (mtd0, 128 MiB);
# U-Boot's environment is at the start of the second bank.
# Device      Offset      Env size   Sector size
/dev/mtd0     0x4000000   0x40000    0x40000

[Unit]
Description=Configure bit rates and bring up CAN interface %I
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
# Defaults; /etc/default/can-bitrate-%i overrides them (CAN_DBITRATE there
# turns on CAN FD, see /usr/libexec/can-up).
Environment=CAN_BITRATE=500000
EnvironmentFile=-/etc/default/can-bitrate-%i
ExecStart=/usr/libexec/can-up %I
ExecStop=/sbin/ip link set dev %I down

[Install]
WantedBy=sys-subsystem-net-devices-%i.device
